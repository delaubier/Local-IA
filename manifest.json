{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "short_name": "Locaya",
  "version": "1.8.0",
  "default_locale": "en",
  "description": "__MSG_extensionDescription__",
  "icons": { "16": "icons/localai-16.png", "32": "icons/localai-32.png", "48": "icons/localai-48.png", "128": "icons/localai-128.png" },
  "action": {
    "default_title": "__MSG_openLocaya__",
    "default_icon": { "16": "icons/localai-16.png", "32": "icons/localai-32.png", "48": "icons/localai-48.png", "128": "icons/localai-128.png" }
  },
  "background": {
    "service_worker": "src/background.ts",
    "type": "module"
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "permissions": [
    "sidePanel",
    "unlimitedStorage",
    "activeTab",
    "tabs",
    "scripting",
    "tabCapture"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "cross_origin_embedder_policy": { "value": "require-corp" },
  "cross_origin_opener_policy": { "value": "same-origin" }
}
